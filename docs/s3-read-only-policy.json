{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyDemoPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR-DEMO-BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["demo/", "demo/*"]
        }
      }
    },
    {
      "Sid": "ReadOnlyObjectsUnderDemoPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::YOUR-DEMO-BUCKET/demo/*"
    }
  ]
}
